---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Clip from '../components/Clip.astro';
import Vimeo from '../components/Vimeo.astro';
import { works, filters, site, clients } from '../data/works.js';
import '../styles/home.css';

const sign = works[0];
const tickEn = ['UI ANIMATION', 'KINETIC TYPE', 'LOGO MOTION', 'ADS', 'REELS'];
const tickAr = ['استمتع', 'اصنع فن', 'حرّك الفكرة'];
const play = '<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>';
const nums = ['٠١', '٠٢', '٠٣', '٠٤', '٠٥', '٠٦'];
---
<Base title="عبدالرحمن البكري — مصمم موشن جرافيك">
  <Header home />
  <main>

  <!-- ============ HERO ============ -->
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="badge" aria-hidden="true">
      <svg class="ring spin" width="156" height="156" viewBox="0 0 156 156" style="position:absolute;inset:0">
        <defs><path id="ring" d="M78,78 m-58,0 a58,58 0 1,1 116,0 a58,58 0 1,1 -116,0"/></defs>
        <circle cx="78" cy="78" r="75" fill="#FFFDF7" stroke="#151312" stroke-width="3"/>
        <text font-family="Rubik" font-size="13.5" font-weight="600" letter-spacing="2.6" fill="#151312"><textPath href="#ring">AVAILABLE FOR WORK ✦ MOTION DESIGNER ✦ </textPath></text>
      </svg>
      <span class="core"><img src="/media/character/albakree.svg" alt="" width="900" height="960" /></span>
    </div>

    <svg class="doodle doodle--star bob" aria-hidden="true" width="70" height="70" viewBox="0 0 70 70" style="--r: 12deg; top: 120px; right: 110px"><path d="M35 4l8 22 23 1-18 14 7 23-20-13-20 13 7-23L4 27l23-1z" fill="#FF9FD6" stroke="#151312" stroke-width="3" stroke-linejoin="round"/></svg>
    <svg class="doodle doodle--wave bob" aria-hidden="true" width="120" height="44" viewBox="0 0 120 44" style="--r: -8deg; animation-delay: -1.2s; bottom: 150px; right: 70px"><path d="M4 22 q14 -20 28 0 t28 0 t28 0 t28 0" fill="none" stroke="#6A2BFF" stroke-width="7" stroke-linecap="round"/></svg>
    <svg class="doodle doodle--dot bob" aria-hidden="true" width="58" height="58" viewBox="0 0 58 58" style="animation-delay: -2s; bottom: 270px; right: 150px"><circle cx="29" cy="29" r="24" fill="#FFC42E" stroke="#151312" stroke-width="3"/><circle cx="29" cy="29" r="9" fill="#151312"/></svg>

    <h1 id="hero-title" class="d hero-title words hfloat">
      <span class="c-o">أهلاً، أنا</span> <span class="c-p">عبدالرحمن.</span><br />
      <span class="c-o">مصمم</span> <span class="hero-pill" data-word aria-hidden="true"><span class="knob slide"></span><span class="tri"></span></span> <span class="c-p">موشن جرافيك</span><br />
      <span class="c-o">أحرّك</span> <span class="c-p">أفكارك</span>
      <img class="smiley" data-word src="/media/character/albakree-smile.svg" alt="عبدالرحمن مبتسم" width="900" height="960" />
    </h1>

    <div class="hero-note t" aria-hidden="true">
      <span class="h sway">شغلي يتحرّك!</span>
      <svg width="110" height="70" viewBox="0 0 110 70" fill="none" stroke="#151312" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 6 C 40 20, 70 30, 96 58"/><path d="M78 56 L 97 59 L 93 40"/></svg>
    </div>

    <div class="hero-tags reveal" style="--rd: .6s">
      <span class="pill d7 chip t" style="background:#FFC42E;--tilt:-2deg">تحريك واجهات</span>
      <span class="pill d7 chip t" style="background:#FF9FD6;--tilt:1.5deg">تايبوغرافي متحرك</span>
      <span class="pill d7 chip t" style="background:#6A2BFF;color:#F4F0E6;--tilt:-1deg">تحريك شعارات</span>
      <span class="pill d7 chip t" style="--tilt:2deg">إعلانات</span>
      <span class="pill d7 chip t" style="background:#F04E14;--tilt:-2.5deg">ريلز</span>
    </div>

    <div class="hero-cta reveal" style="--rd: .8s">
      <a class="btn btn--orange d7 float" href="#work">شاهد أعمالي <Fragment set:html={play} /></a>
      <a class="btn d7 float2" href="#contact">راسلني</a>
    </div>
  </section>

  <!-- ============ CROSSING TICKERS ============ -->
  <section class="cross" aria-hidden="true">
    <div class="band band--a ticker">
      <div class="ticker-track tickR d" dir="ltr" style="--tk:85s">
        {Array.from({ length: 10 }).flatMap(() => tickEn).map((t) => <><span>{t}</span><span>✦</span></>)}
      </div>
    </div>
    <div class="band band--b ticker">
      <div class="ticker-track tickL d" dir="ltr" style="--tk:95s">
        {Array.from({ length: 16 }).flatMap(() => tickAr).map((t) => <><span>{t}</span><span style="color:#FFC42E">✦</span></>)}
      </div>
    </div>
  </section>

  <!-- ============ FEATURED: كيف جاء ساين ============ -->
  <section class="featured wrap" aria-labelledby="featured-title">
    <span class="d sticker bob" aria-hidden="true">شوف هذا!</span>
    <svg class="star spin" aria-hidden="true" width="84" height="84" viewBox="0 0 84 84"><path d="M42 4 L50 30 L78 26 L56 44 L72 70 L44 58 L22 78 L26 50 L4 36 L32 32 Z" fill="#FF9FD6" stroke="#151312" stroke-width="3.5" stroke-linejoin="round"/></svg>

    <div class="card ae reveal hfloat">
      <div class="ae-bar">
        <div class="dots" aria-hidden="true"><i style="background:#F04E14"></i><i style="background:#FFC42E"></i><i style="background:#6A2BFF"></i></div>
        <h2 id="featured-title" class="fname" dir="ltr"><span class="sr">العمل المميز: كيف جاء ساين؟ — </span>Sign_Burger_Story_FINAL_v3_(final_final).mp4</h2>
        <span class="live" dir="ltr"><span class="blink" style="width:10px;height:10px;border-radius:50%;background:#F04E14"></span>PLAYING</span>
      </div>

      <div class="stage">
        <div class="sun bob" aria-hidden="true"></div>
        <div class="ringd spin" aria-hidden="true"></div>
        <div class="sq t float2" aria-hidden="true"></div>
        <div class="phone phone--side t float" style="--tilt:-5deg"><Clip src="/media/sign/night.mp4" poster="/media/sign/posters/night.jpg" /></div>
        <div class="phone phone--main">
          <Vimeo id={sign.vimeo} thumb={sign.thumb} title={sign.title} />
        </div>
        <div class="phone phone--side t float2" style="--tilt:4deg"><Clip src="/media/sign/grid.mp4" poster="/media/sign/posters/grid.jpg" /></div>
        <div class="stage-cap"><span class="d7">كيف جاء ساين؟ · اضغط للتشغيل</span></div>
      </div>

      <div class="tl" dir="ltr" aria-hidden="true">
        <div class="ruler"><span>0:00</span><span>0:15</span><span>0:30</span><span>0:45</span><span>1:00</span><span>1:15</span><span>1:30</span></div>
        <div class="row"><span>Text</span><div class="lane"><i class="bar" style="left:4%;width:42%;background:#6A2BFF"></i><i class="key" style="left:4%"></i><i class="key" style="left:44%"></i></div></div>
        <div class="row"><span>Shape Layer</span><div class="lane"><i class="bar" style="left:22%;width:58%;background:#F04E14"></i><i class="key" style="left:22%"></i><i class="key" style="left:50%"></i><i class="key" style="left:78%"></i></div></div>
        <div class="row"><span>Camera</span><div class="lane"><i class="bar" style="left:0;width:100%;background:#FF9FD6;opacity:.85"></i><i class="key" style="left:0"></i><i class="key" style="left:97%"></i></div></div>
        <div class="heads"><div class="playhead"></div></div>
      </div>
    </div>

    <div class="featured-more reveal">
      <a class="btn btn--yellow d7 float" href="/work/sign/">قصة العمل من الداخل ←</a>
    </div>
  </section>

  <!-- ============ PROOF ============ -->
  <section class="proof wrap">
    <p class="drift reveal">أصمّم <span class="hl">موشن جرافيك</span> يخلّي العلامات تنبض بالحياة — بأسلوب مرح، وتفاصيل محسوبة، وتسليم في الوقت.</p>
    <div class="stats">
      <div class="stat float t reveal" style="background:#FFC42E;--tilt:-3deg"><span class="d" dir="ltr">Ae</span><span>After Effects للحركة</span></div>
      <div class="stat float2 t reveal" style="background:#FF9FD6;--tilt:2deg;--rd:.1s"><span class="d" dir="ltr">Pr</span><span>Premiere للمونتاج والصوت</span></div>
      <div class="stat float t reveal" style="background:#FFFDF7;--tilt:-1.5deg;--rd:.2s"><span class="d">٩:١٦</span><span>ريلز عمودية بإيقاع سريع</span></div>
    </div>
  </section>

  <!-- ============ ABOUT ============ -->
  <section id="about" class="about wrap">
    <div class="about-hi">
      <h2 class="d words hfloat">أهلاً بك في<br />عالم <span class="boxed t" data-word>البكري</span></h2>
      <svg class="reveal" width="240" height="180" viewBox="0 0 240 180" fill="none" stroke="#151312" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="رسمة: مصمم على مكتبه وعلى الشاشة كرة تتنطط">
        <path d="M8 158 H232"/><rect x="112" y="34" width="112" height="78" rx="8" fill="#FFFDF7"/><path d="M168 112 V134 M144 134 H192"/><path d="M124 100 H212" stroke-width="2.5" stroke-dasharray="4 5"/>
        <circle class="ball" cx="168" cy="86" r="11" fill="#F04E14"/><rect x="112" y="140" width="64" height="7" rx="3"/>
        <circle cx="58" cy="58" r="15" fill="#FFFDF7"/><path d="M50 52 q3 -3 6 0" stroke-width="2.5"/><path d="M58 73 C 52 98, 52 114, 64 136"/><path d="M60 90 C 80 100, 96 112, 116 140"/><path d="M64 136 H96 V158"/><path d="M34 104 V158 M34 132 H70"/>
      </svg>
    </div>

    <div class="photo reveal">
      <!-- TODO: صورة عبدالرحمن على المكتب -->
      <div class="photo-box char-box float2"><img src="/media/character/albakree.svg" alt="عبدالرحمن البكري — الكاركتر" width="900" height="960" loading="lazy" /></div>
      <div class="photo-note t" aria-hidden="true">
        <span class="h sway">هذا أنا!</span>
        <svg width="90" height="60" viewBox="0 0 90 60" fill="none" stroke="#151312" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 40px"><path d="M10 6 C 30 14, 50 30, 66 52"/><path d="M50 50 L 67 53 L 66 36"/></svg>
      </div>
    </div>

    <div class="about-txt">
      <h3 class="d words hfloat">مصمم موشن جرافيك مستقل</h3>
      <span class="pill d7 chip" style="align-self:flex-start;background:#FF9FD6">تحريك واجهات وتايبوغرافي</span>
      <p class="drift reveal">أهلاً، أنا عبدالرحمن. أحوّل أفكار العلامات التجارية والمنتجات إلى حركة تشدّ الانتباه — من إعلان قصير إلى هوية متحركة كاملة.</p>
      <p class="drift reveal">أشتغل مع الشركات والوكالات وأصحاب المشاريع مباشرة، وأستمتع بكل إطار كأنه الوحيد.</p>
    </div>
  </section>

  <!-- ============ WORK ============ -->
  <section id="work" class="work wrap" aria-labelledby="work-title">
    <div class="work-head">
      <h2 id="work-title" class="d words hfloat"><span class="c-o">أعمال</span> <span class="c-p underline">مختارة<svg aria-hidden="true" viewBox="0 0 320 30" preserveAspectRatio="none" fill="none" stroke="#FFC42E" stroke-width="9" stroke-linecap="round"><path d="M6 18 C 90 6, 220 8, 314 16"/></svg></span></h2>
      <div class="filters d7 reveal" role="group" aria-label="تصنيف الأعمال" data-filters>
        {filters.map((f, i) => <button type="button" data-f={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>)}
      </div>
    </div>

    <div class="showcase">
      {works.map((w, i) => (
        <a href={`/work/${w.slug}/`} class:list={['pc reveal', i % 2 ? 'float2' : 'float']}
           style={`--rd:${(i % 3) * 0.1}s`} data-tags={w.filters.join(' ')}
           aria-label={`${w.title} — ${w.type}، شوف العمل`}>
          <div class="pc-media" style={`background:${w.color}`}>
            <span class="pc-num d">{nums[i]}</span>
            <span class="pill d7 pc-type chip">{w.tag}</span>
            <div class={`pc-frame pc-frame--${w.slug === 'notion' ? 'n' : w.orientation}`} style={`rotate:${i % 2 ? '3deg' : '-3deg'}`}>
              {w.clip
                ? <Clip src={w.clip.src} poster={w.clip.poster} />
                : <img src={w.thumb} alt="" loading="lazy" decoding="async" />}
            </div>
          </div>
          <div class="pc-body">
            <span class="d pc-title">{w.title}</span>
            <span class="cv pc-en" dir="ltr" style="text-align:right">{w.titleEn}</span>
            <div class="pc-meta"><span>{w.client}</span><span>{w.duration}</span><span>{w.year}</span></div>
            <div class="pc-go"><span class="d7">شوف العمل <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"/></svg></span></div>
          </div>
        </a>
      ))}
    </div>

    <div class="work-more reveal">
      <a class="btn btn--yellow d7 float2" href="https://www.behance.net/albakreegraphic" target="_blank" rel="noopener">كل الأعمال على Behance ↗</a>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section id="services" class="services wrap" aria-labelledby="svc-title">
    <h2 id="svc-title" class="d words hfloat">وش أقدر أسوي <span class="circled" data-word>لك؟<svg aria-hidden="true" viewBox="0 0 230 140" preserveAspectRatio="none" fill="none" stroke="#6A2BFF" stroke-width="5" stroke-linecap="round"><path pathLength="1" vector-effect="non-scaling-stroke" d="M40 22 C 100 2, 200 10, 218 58 C 232 104, 150 136, 80 128 C 18 120, 4 80, 20 50 C 32 28, 60 16, 96 12"/></svg></span></h2>
    <div class="svc-row">
      <div class="svc t float reveal" style="background:#6A2BFF;color:#F4F0E6;--tilt:-3deg">
        <span class="d num">01</span>
        <svg class="art" width="110" height="110" viewBox="0 0 110 110" fill="none" stroke="#F4F0E6" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="30" y="8" width="50" height="94" rx="12"/><rect x="40" y="30" width="30" height="16" rx="8" fill="#FFC42E" stroke="#151312"/><path d="M40 60 H70 M40 72 H60"/></svg>
        <div class="txt"><span class="d">تحريك الواجهات</span><span>فيديوهات إطلاق التطبيقات والمواقع.</span></div>
      </div>
      <div class="svc t float2 reveal" style="background:#FFC42E;--tilt:2deg;--rd:.08s">
        <span class="d num">02</span>
        <div class="art" aria-hidden="true" style="display:flex;align-items:center;gap:6px"><span class="d wig" style="font-size:96px;line-height:1">أ</span><svg width="40" height="60" viewBox="0 0 40 60" fill="none" stroke="#151312" stroke-width="4.5" stroke-linecap="round"><path d="M4 14 H34 M10 30 H38 M4 46 H28"/></svg></div>
        <div class="txt"><span class="d">تايبوغرافي متحرك</span><span>نصوص ترقص على إيقاع الكلام.</span></div>
      </div>
      <div class="svc t float reveal" style="background:#FFFDF7;--tilt:-1.5deg;--rd:.16s">
        <span class="d num" style="background:#FF9FD6">03</span>
        <svg class="art spin" width="110" height="110" viewBox="0 0 110 110" aria-hidden="true"><path d="M55 6 L65 38 L98 30 L76 56 L100 82 L66 78 L60 104 L46 80 L16 96 L28 66 L6 44 L38 40 L30 10 Z" fill="#F04E14" stroke="#151312" stroke-width="4" stroke-linejoin="round"/></svg>
        <div class="txt"><span class="d">تحريك الشعارات</span><span>شعارك يدخل المشهد بشخصية.</span></div>
      </div>
      <div class="svc t float2 reveal" style="background:#F04E14;--tilt:3deg;--rd:.24s">
        <span class="d num">04</span>
        <svg class="art bob" width="120" height="100" viewBox="0 0 150 120" aria-hidden="true"><path d="M10 50 L90 20 L90 100 L10 70 Z" fill="#FFFDF7" stroke="#151312" stroke-width="5" stroke-linejoin="round"/><rect x="90" y="36" width="22" height="48" rx="6" fill="#FFC42E" stroke="#151312" stroke-width="5"/><path d="M124 44 q14 16 0 32" fill="none" stroke="#151312" stroke-width="5" stroke-linecap="round"/></svg>
        <div class="txt"><span class="d">إعلانات موشن</span><span>رسالتك كاملة في ثوانٍ.</span></div>
      </div>
      <div class="svc t float reveal" style="background:#FF9FD6;--tilt:-2deg;--rd:.32s">
        <span class="d num">05</span>
        <svg class="art" width="80" height="120" viewBox="0 0 80 120" aria-hidden="true"><rect x="6" y="4" width="68" height="112" rx="14" fill="#151312"/><rect x="12" y="10" width="56" height="100" rx="10" fill="#6A2BFF"/><path class="pulse" style="transform-origin:43px 60px" d="M32 46 v28 l22 -14 z" fill="#F4F0E6"/></svg>
        <div class="txt"><span class="d">ريلز وسوشال</span><span>محتوى عمودي يوقف التمرير.</span></div>
      </div>
    </div>
  </section>

  <!-- ============ CLIENTS ============ -->
  <section class="clients wrap" aria-labelledby="clients-title">
    <h2 id="clients-title" class="d hfloat" style="font-size:30px">اشتغلت مع <span class="h sway" style="color:#6A2BFF">ناس رائعين</span></h2>
    <div class="client-row">
      {clients.map((c, i) => (
        <span class={`client d t reveal ${i % 2 ? 'float2' : 'float'}`} style={`--tilt:${['-1.5deg', '1deg', '-.8deg', '1.8deg', '-1.2deg'][i % 5]};--rd:${i * 0.08}s`}>
          {c.logo ? <img src={c.logo} alt={c.name} width={c.w} height={c.h} loading="lazy" decoding="async" /> : c.name}
        </span>
      ))}
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section id="contact" class="contact reveal hfloat" aria-labelledby="contact-title">
    <div class="contact-l">
      <div class="contact-h">
        <h2 id="contact-title" class="d words hfloat">لنتحدّث!</h2>
        <svg class="cup" width="110" height="150" viewBox="0 0 110 150" role="img" aria-label="كوب شاي">
          <path class="steam" d="M40 36 q-10 -12 0 -24 q10 -12 0 -24" fill="none" stroke="#F4F0E6" stroke-width="4" stroke-linecap="round" transform="translate(0 30)"/>
          <path class="steam" d="M64 36 q-10 -12 0 -24 q10 -12 0 -24" fill="none" stroke="#F4F0E6" stroke-width="4" stroke-linecap="round" transform="translate(0 30)" style="animation-delay: -1.2s"/>
          <path d="M22 66 L30 136 Q31 142 38 142 L72 142 Q79 142 80 136 L88 66 Z" fill="#FFFDF7" stroke="#151312" stroke-width="4" stroke-linejoin="round"/>
          <path d="M27 86 L83 86 L78 132 Q77 136 72 136 L38 136 Q33 136 32 132 Z" fill="#C2410C"/>
          <ellipse cx="55" cy="66" rx="34" ry="6" fill="#FFFDF7" stroke="#151312" stroke-width="4"/>
        </svg>
        <svg class="ul" aria-hidden="true" viewBox="0 0 560 44" preserveAspectRatio="none" fill="none" stroke="#FFC42E" stroke-width="7" stroke-linecap="round"><path d="M6 14 C 170 4, 380 6, 554 16"/><path d="M70 30 C 220 22, 360 24, 470 32"/></svg>
      </div>
      <span class="h note t sway">عندك فكرة؟ تعال نتكلم على كوب شاي</span>
      <div class="contact-btns">
        {site.whatsapp
          ? <a class="btn btn--yellow d7 float" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">واتساب</a>
          : <a class="btn btn--yellow d7 float" aria-disabled="true" title="بانتظار رقم الواتساب">[ واتساب ]</a>}
        {site.email
          ? <a class="btn d7 float2" href={`mailto:${site.email}`} title={site.email}>الإيميل</a>
          : <a class="btn d7 float2" aria-disabled="true" title="بانتظار الإيميل">[ بريدك ]</a>}
        <a class="btn d7 float" href="https://www.instagram.com/abdulrahmanalbakree" target="_blank" rel="noopener">Instagram</a>
      </div>
    </div>

    <form class="cform" data-contact data-wa={site.whatsapp} data-mail={site.email}>
      <label class="d7">اسمك<input name="name" type="text" autocomplete="name" required /></label>
      <label class="d7">البريد أو الواتساب<input name="reach" type="text" required /></label>
      <label class="d7">احكي لي عن فكرتك<textarea name="idea" rows="4" required></textarea></label>
      <button class="btn btn--orange d float" type="submit">أرسل ←</button>
      <p class="form-note" data-note hidden>الإرسال يتفعّل قريباً — راسلني الآن على إنستقرام <span dir="ltr">{site.handle}</span></p>
    </form>
  </section>

  </main>
</Base>
