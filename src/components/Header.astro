---
interface Props { home?: boolean; }
const { home = false } = Astro.props;
const arrow = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>';
---
<header class="site-header" id="top">
  <a href="/" class="logo" aria-label="عبدالرحمن البكري — الرئيسية">
    <span class="logo-mark"><img src="/media/character/albakree.svg" alt="" width="900" height="960" /></span>
    <span class="d7 logo-name">عبدالرحمن البكري</span>
  </a>
  {home ? (
    <>
      <nav class="nav d7" aria-label="القائمة الرئيسية">
        <a href="#top" aria-current="true">الرئيسية</a>
        <a href="#work">الأعمال</a>
        <a href="#services">الخدمات</a>
        <a href="#about">عني</a>
      </nav>
      <a class="btn btn--sm btn--orange d7 float" href="#contact">ابدأ مشروعك <Fragment set:html={arrow} /></a>
    </>
  ) : (
    <a class="btn btn--sm d7 float" href="/#work">كل الأعمال <Fragment set:html={arrow} /></a>
  )}
</header>
